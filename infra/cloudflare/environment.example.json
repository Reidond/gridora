{
  "environment": "staging",
  "accountId": "replace-with-32-character-cloudflare-account-id",
  "zoneId": "replace-with-32-character-cloudflare-zone-id",
  "zoneName": "gridora.example",
  "apiHostname": "api.staging.gridora.example",
  "publicAppHostname": "app.staging.gridora.example",
  "consoleHostname": "console.staging.gridora.example",
  "dnsTarget": "nodes.staging.gridora.example",
  "resourcePrefix": "gridora-staging",
  "d1DatabaseId": "replace-with-terraform-d1-uuid",
  "accessIssuer": "https://your-team.cloudflareaccess.com",
  "accessAudience": "replace-with-terraform-access-audience",
  "secretsStoreId": "replace-with-cloudflare-secrets-store-uuid",
  "agentCommandSigningPublicKeyPem": "replace-with-ed25519-public-key-pem",
  "nodeImageTrustedPublicKeyDigests": "sha256:replace-with-64-lowercase-hex-digest",
  "agentVersion": "0.1.0",
  "nodeBootstrapTtlSeconds": 900,
  "invitationEmailFrom": "invitations@gridora.example",
  "registrationMode": "open",
  "providerByopEnabled": false,
  "invitationTokenKeyVersion": "v1",
  "providerKekActiveVersion": "1",
  "nodeRegistrationTokenKeyVersion": "1"
}
