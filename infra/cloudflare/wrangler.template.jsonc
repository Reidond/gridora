{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gridora-api",
  "main": "../../apps/api/src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "ACCESS_ISSUER": "https://your-team.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "replace-with-access-application-audience",
    "PUBLIC_APP_ORIGIN": "https://app.gridora.example",
    "CONSOLE_ORIGIN": "https://console.gridora.example",
    "INVITATION_TOKEN_KEY_VERSION": "v1",
    "REGISTRATION_MODE": "open",
    "CLOUDFLARE_DNS_ZONE_ID": "replace-with-cloudflare-dns-zone-id",
    "NODE_IMAGE_TRUSTED_PUBLIC_KEY_DIGESTS": "replace-with-comma-separated-sha256-public-key-digests",
  },
  "secrets": {
    "required": [
      "INTERNAL_SERVICE_SECRET",
      "SERVER_PROVISION_COMMERCIAL_REVIEW_SECRET",
      "REALTIME_TICKET_SECRET",
      "INVITATION_TOKEN_SECRET",
      "NODE_CREDENTIAL_SECRET",
      "NODE_REGISTRATION_TOKEN_SECRET",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gridora-control-plane",
      "migrations_dir": "../../packages/migrations/sql",
    },
  ],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "gridora-artifacts" },
    { "binding": "BACKUPS", "bucket_name": "gridora-backups" },
    { "binding": "LOGS", "bucket_name": "gridora-logs" },
    {
      "binding": "NOTIFICATION_REMEDIATION",
      "bucket_name": "gridora-notification-remediation",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "OUTBOX_WAKEUPS", "queue": "gridora-outbox-publisher" },
      { "binding": "AGENT_EVENTS", "queue": "gridora-agent-events" },
      { "binding": "TELEMETRY", "queue": "gridora-telemetry" },
      { "binding": "AUDIT_EXPORT", "queue": "gridora-audit-export" },
      { "binding": "RECONCILIATION", "queue": "gridora-reconciliation" },
      { "binding": "NOTIFICATIONS", "queue": "gridora-notifications" },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RESOURCE_OPERATION",
        "class_name": "ResourceOperationDO",
        "script_name": "gridora-realtime",
      },
      {
        "name": "ORGANIZATION_EVENTS",
        "class_name": "OrganizationEventsDO",
        "script_name": "gridora-realtime",
      },
      {
        "name": "INTERNAL_REPLAY_GUARD",
        "class_name": "InternalReplayGuardDO",
        "script_name": "gridora-realtime",
      },
      {
        "name": "AUTH_INTENT_RATE_LIMIT",
        "class_name": "AuthIntentRateLimitDO",
        "script_name": "gridora-realtime",
      },
      {
        "name": "AUTH_INTENT_STATE",
        "class_name": "AuthIntentStateDO",
        "script_name": "gridora-realtime",
      },
      {
        "name": "NODE_COORDINATOR",
        "class_name": "NodeCoordinatorDO",
        "script_name": "gridora-realtime",
      },
      {
        "name": "LIVE_LOG_STREAM",
        "class_name": "LiveLogStreamDO",
        "script_name": "gridora-realtime",
      },
    ],
  },
  "workflows": [
    {
      "binding": "DELETE_ORGANIZATION",
      "name": "gridora-delete-organization",
      "class_name": "DeleteOrganizationWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "PROVISION_NODE",
      "name": "gridora-provision-node",
      "class_name": "ProvisionNodeWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "SERVER_PROVISION_PLAN",
      "name": "gridora-server-provision-plan",
      "class_name": "ServerProvisionPlanWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "REBUILD_NODE",
      "name": "gridora-rebuild-node",
      "class_name": "RebuildNodeWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "RETIRE_NODE",
      "name": "gridora-retire-node",
      "class_name": "RetireNodeWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "DRAIN_NODE",
      "name": "gridora-drain-node",
      "class_name": "DrainNodeWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "LEAVE_DRAIN_NODE",
      "name": "gridora-leave-drain-node",
      "class_name": "LeaveDrainNodeWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "NODE_RUNTIME_LIFECYCLE",
      "name": "gridora-node-runtime-lifecycle",
      "class_name": "NodeRuntimeLifecycleWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "NODE_IMAGE_LIFECYCLE",
      "name": "gridora-node-image-lifecycle",
      "class_name": "NodeImageLifecycleWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "DEPLOY_GAME_SERVER",
      "name": "gridora-deploy-game-server",
      "class_name": "DeployGameServerWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "START_GAME_SERVER",
      "name": "gridora-start-game-server",
      "class_name": "StartGameServerWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "STOP_GAME_SERVER",
      "name": "gridora-stop-game-server",
      "class_name": "StopGameServerWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "RESTART_GAME_SERVER",
      "name": "gridora-restart-game-server",
      "class_name": "RestartGameServerWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "UPDATE_GAME_SERVER",
      "name": "gridora-update-game-server",
      "class_name": "UpdateGameServerWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "APPLY_GAME_CONFIG",
      "name": "gridora-apply-game-config",
      "class_name": "ApplyGameConfigWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "SYNC_MODS",
      "name": "gridora-sync-mods",
      "class_name": "SyncModsWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "BACKUP_GAME_SERVER",
      "name": "gridora-backup-game-server",
      "class_name": "BackupGameServerWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "RESTORE_GAME_SERVER",
      "name": "gridora-restore-game-server",
      "class_name": "RestoreGameServerWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "MOVE_GAME_SERVER",
      "name": "gridora-move-game-server",
      "class_name": "MoveGameServerWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "DELETE_GAME_SERVER",
      "name": "gridora-delete-game-server",
      "class_name": "DeleteGameServerWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "REGISTER_PROVIDER_IMAGE",
      "name": "gridora-register-provider-image",
      "class_name": "RegisterProviderImageWorkflow",
      "script_name": "gridora-workflows",
    },
    {
      "binding": "RECONCILE_ORPHAN",
      "name": "gridora-reconcile-orphan",
      "class_name": "ReconcileOrphanWorkflow",
      "script_name": "gridora-workflows",
    },
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
}
