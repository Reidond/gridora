[Unit]
Description=Gridora bounded plugin egress lease socket
After=nftables.service gridora-plugin-egress-network.service
Requires=nftables.service gridora-plugin-egress-network.service

[Socket]
ListenStream=/run/gridora/plugin-egress-lease.sock
SocketUser=root
SocketGroup=gridora-agent
SocketMode=0660
DirectoryMode=0755
Accept=yes
MaxConnections=4
RemoveOnStop=true

[Install]
WantedBy=sockets.target
