#!/usr/bin/env bash
set -euo pipefail

nft_command=${GRIDORA_TEST_NFT_COMMAND:-/usr/sbin/nft}
work=$(mktemp -d)
trap 'rm -rf "${work}"' EXIT
request=${work}/request.json
entries=${work}/entries.tsv

head -c 65537 >"${request}"
[[ $(wc -c <"${request}") -le 65536 ]]

jq -er '
  def public_v4:
    test("^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$") and
    (split(".") | map(tonumber)) as $o |
    ($o | length) == 4 and all($o[]; . >= 0 and . <= 255) and
    ($o[0] != 0) and ($o[0] != 10) and ($o[0] != 127) and
    (($o[0] == 100 and $o[1] >= 64 and $o[1] <= 127) | not) and
    (($o[0] == 169 and $o[1] == 254) | not) and
    (($o[0] == 172 and $o[1] >= 16 and $o[1] <= 31) | not) and
    (($o[0] == 192 and ($o[1] == 0 or $o[1] == 168)) | not) and
    (($o[0] == 198 and ($o[1] == 18 or $o[1] == 19 or $o[1] == 51)) | not) and
    (($o[0] == 203 and $o[1] == 0 and $o[2] == 113) | not) and
    ($o[0] < 224);
  select(
    .schemaVersion == 1 and
    (.action == "acquire" or .action == "release") and
    (.leaseId | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")) and
    (.entries | type == "array" and length > 0 and length <= 1024) and
    all(.entries[];
      (keys | sort) == ["address", "port", "protocol"] and
      (.address | public_v4) and
      (.protocol == "tcp" or .protocol == "udp") and
      (.port | type == "number" and floor == . and . >= 1 and . <= 65535)
    ) and
    (keys | sort) == ["action", "entries", "leaseId", "schemaVersion"]
  ) |
  .action as $action |
  .entries | unique_by([.address, .protocol, .port])[] |
  [$action, .address, .protocol, (.port | tostring)] | @tsv
' "${request}" >"${entries}"

[[ -s "${entries}" ]]
while IFS=$'\t' read -r action address protocol port; do
  element="{ \"gridora-egress0\" . ${address} . ${protocol} . ${port} timeout 65m }"
  if [[ "${action}" == acquire ]]; then
    if ! timeout 5s "${nft_command}" get element inet gridora permitted_game_egress_v4 "${element}" >/dev/null 2>&1; then
      timeout 5s "${nft_command}" add element inet gridora permitted_game_egress_v4 "${element}"
    fi
  elif timeout 5s "${nft_command}" get element inet gridora permitted_game_egress_v4 "${element}" >/dev/null 2>&1; then
    timeout 5s "${nft_command}" delete element inet gridora permitted_game_egress_v4 "${element}"
  fi
done <"${entries}"

jq -cn --arg leaseId "$(jq -r .leaseId "${request}")" '{schemaVersion:1, leaseId:$leaseId, applied:true}'
