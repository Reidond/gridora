{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gridora-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": { "required": ["REALTIME_TICKET_SECRET"] },
  "durable_objects": {
    "bindings": [
      { "name": "NODE_COORDINATOR", "class_name": "NodeCoordinatorDO" },
      { "name": "RESOURCE_OPERATION", "class_name": "ResourceOperationDO" },
      { "name": "ORGANIZATION_EVENTS", "class_name": "OrganizationEventsDO" },
      { "name": "LIVE_LOG_STREAM", "class_name": "LiveLogStreamDO" },
      { "name": "INTERNAL_REPLAY_GUARD", "class_name": "InternalReplayGuardDO" },
      { "name": "AUTH_INTENT_RATE_LIMIT", "class_name": "AuthIntentRateLimitDO" },
      { "name": "AUTH_INTENT_STATE", "class_name": "AuthIntentStateDO" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NodeCoordinatorDO", "ResourceOperationDO", "OrganizationEventsDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["InternalReplayGuardDO", "AuthIntentStateDO", "AuthIntentRateLimitDO"],
    },
    { "tag": "v3", "new_sqlite_classes": ["LiveLogStreamDO"] },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
