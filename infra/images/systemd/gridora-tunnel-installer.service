[Unit]
Description=Gridora root tunnel credential installer
Requires=gridora-tunnel-installer.socket
After=local-fs.target
Before=gridora-agent.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/gridora-agent tunnel-installer --listen-fd 3
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
StateDirectory=gridora/tunnel
StateDirectoryMode=0700
ReadWritePaths=/var/lib/gridora/tunnel
UMask=0077

[Install]
WantedBy=multi-user.target
