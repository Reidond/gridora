{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gridora-web",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
