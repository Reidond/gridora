[Unit]
Description=Erase Gridora bootstrap copies after agent handoff
After=gridora-node-bootstrap.service
Requires=gridora-node-bootstrap.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/gridora/gridora-node-bootstrap-cleanup
RemainAfterExit=true
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/gridora /var/lib/cloud /var/log /run/cloud-init /etc/cloud
