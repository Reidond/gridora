[Unit]
Description=Gridora one-time node bootstrap handoff
Documentation=https://github.com/Reidond/gridora/blob/main/docs/adr/0045-promoted-image-bootstrap-handoff.md
After=cloud-final.service network-online.target docker.service
Wants=network-online.target
Requires=docker.service
Before=gridora-agent.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/gridora/gridora-node-bootstrap
RemainAfterExit=true
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/etc/gridora /var/lib/gridora /var/lib/cloud /var/log /run/cloud-init /etc/cloud /run/systemd

[Install]
WantedBy=multi-user.target
